{
    "name": "misaf/vendra-tenant",
    "description": "Generic multi-tenancy engine: tenant context, resolution, switching, and isolation for a configurable tenant model",
    "keywords": [
        "laravel",
        "filamentphp",
        "tenant"
    ],
    "homepage": "https://github.com/misaf/vendra-tenant",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-multitenancy": "^4.1.3",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraTenant\\": "src/",
            "Misaf\\VendraTenant\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraTenant\\Providers\\TenantServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-tenant/issues",
        "source": "https://github.com/misaf/vendra-tenant"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
